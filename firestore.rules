rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------
    // NOTE: these live INSIDE match /databases/{database}/documents so the
    // $(database) binding resolves correctly.

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function roleExists(uid) {
      return exists(userDoc(uid));
    }

    function getRole(uid) {
      // Role is stored on the users/{uid} document.
      // exists() guard: get() on a missing doc throws and denies the
      // request, which deadlocks bootstrap (new user has no role doc yet).
      return roleExists(uid) ? get(userDoc(uid)).data.role : '';
    }

    function isStaff() {
      return isSignedIn() && roleExists(request.auth.uid) && getRole(request.auth.uid) in
        ['super-admin', 'receptionist', 'security-officer'];
    }

    function isHost() {
      return isSignedIn() && roleExists(request.auth.uid) && getRole(request.auth.uid) == 'host';
    }

    function isSuperAdmin() {
      return isSignedIn() && roleExists(request.auth.uid) && getRole(request.auth.uid) == 'super-admin';
    }

    // Base64 facial captures are large. Keep every photoUrl under ~950KB
    // so a single write can never exceed the 1MiB document limit.
    function isPhotoAllowed(newData) {
      return !('photoUrl' in newData)
        || newData.photoUrl == null
        || (newData.photoUrl is string && newData.photoUrl.size() < 950000);
    }

    // Visit lifecycle: Pre-Registered -> Checked In -> Checked Out.
    // A visit may keep the same status or move forward only.
    function isValidStatusTransition(before, after) {
      return before == after
        || (before == 'Pre-Registered' && after == 'Checked In')
        || (before == 'Checked In' && after == 'Checked Out')
        || (before == 'Pre-Registered' && after == 'Checked Out');
    }

    // The only fields staff may change when checking a visitor in/out,
    // extending a visit, running the stay monitor, or recording identity and
    // facial verification results.
    function isVisitUpdateAllowed(before, after) {
      return isValidStatusTransition(before.status, after.status)
        && after.diff(before).affectedKeys().hasOnly([
          'status',
          'checkInTime',
          'checkInBy',
          'expectedCheckoutTime',
          'duration',
          'durationMinutes',
          'photoUrl',
          'frequentVisitorId',
          'checkOutTime',
          'checkOutBy',
          'reminderSent',
          'reminderSentAt',
          'expiredEmailSent',
          'expiredEmailSentAt',
          'registrationEmailSent',
          'extendCount',
          'lastExtendedAt',
          'verificationStatus',
          'verificationMethod',
          'verifiedAt',
          'verifiedBy',
          'facialVerificationStatus',
          'facialVerificationAt',
        ]);
    }

    // A Host may only set registrationEmailSent on their own Pre-Registered
    // visit. They cannot touch any other field or progress the status.
    function isHostRegistrationUpdateAllowed(before, after) {
      return before.registeredBy == request.auth.uid
        && before.status == 'Pre-Registered'
        && after.status == 'Pre-Registered'
        && after.diff(before).affectedKeys().hasOnly(['registrationEmailSent']);
    }

    // A Host may extend the end time of a visit they registered once it is
    // checked in (the derived Expired state keeps db status 'Checked In').
    // Status never changes here and only extension-related fields may move.
    function isHostExtendAllowed(before, after) {
      return before.registeredBy == request.auth.uid
        && before.status == 'Checked In'
        && after.status == 'Checked In'
        && after.diff(before).affectedKeys().hasOnly([
          'expectedCheckoutTime',
          'reminderSent',
          'reminderSentAt',
          'expiredEmailSent',
          'expiredEmailSentAt',
          'extendCount',
          'lastExtendedAt',
        ]);
    }

    // Badge-first flow: the Host (or Admin) creates the badge up front. The
    // visit is stored as Pre-Registered with a host-issued badgeNumber, the
    // visitor is notified by email, and at arrival they only complete facial
    // capture at reception — the badge number is already theirs.
    // A Host may therefore register a new visitor only as a Pre-Registered
    // visit tied to their own account, carrying a non-empty badgeNumber and
    // no facial/verification data (captured later by staff at reception).
    function isHostRegistrationCreateAllowed(newData) {
      return newData.status == 'Pre-Registered'
        && newData.type == 'visitor'
        && newData.registeredBy == request.auth.uid
        && newData.badgeNumber is string
        && newData.badgeNumber.size() > 0
        && newData.keys().hasAll([
          'badgeNumber',
          'profileId',
          'expectedCheckoutTime',
          'registeredBy',
          'status',
          'type',
          'hostId',
        ])
        && (!('photoUrl' in newData) || newData.photoUrl == null)
        && (!('facialVerificationStatus' in newData) || newData.facialVerificationStatus == null)
        && (!('verificationStatus' in newData) || newData.verificationStatus == null);
    }

    // A Host may create a new frequent-visitor profile tagged as
    // host-created. Photos ARE allowed (DigitalBadge "Save as Frequent
    // Visitor" sends the kiosk capture) but capped so the doc stays small.
    // createdBy is optional for backwards compatibility with clients that
    // omit it (e.g. DigitalBadge.jsx); when present it must be host/kiosk.
    function isHostProfileCreateAllowed(newData) {
      return newData.keys().hasAll(['name', 'phone'])
        && (!('createdBy' in newData) || newData.createdBy in ['host', 'kiosk'])
        && isPhotoAllowed(newData);
    }

    function isFrequentCounterUpdateAllowed(before, after) {
      // Hosts/kiosk may bump counters on reuse, nothing else.
      return after.diff(before).affectedKeys().hasOnly(['visitCount', 'lastVisit'])
        && (!('visitCount' in after) || !('visitCount' in before)
          || after.visitCount is int && before.visitCount is int
          && after.visitCount >= before.visitCount);
    }

    // ----- Kiosk self-service (unauthenticated Confirm & Send) -----
    // CheckInForm runs on a logged-out kiosk and sends registeredBy/checkInBy
    // as null (user?.uid || null). Without this branch every kiosk write is
    // permission-denied by design. This opens ONLY narrowly-validated
    // creates/updates: no public read, no delete, no privilege fields.
    function isKioskVisitorCreateAllowed(newData) {
      return newData.status in ['Checked In', 'Pre-Registered']
        && newData.type == 'visitor'
        && newData.badgeNumber is string
        && newData.badgeNumber.size() > 0
        && newData.name is string
        && newData.name.size() > 0
        && newData.phone is string
        && newData.phone.size() > 0
        && newData.email is string
        && newData.email.size() > 0
        && newData.hostName is string
        && newData.hostName.size() > 0
        && newData.keys().hasAll([
          'badgeNumber',
          'name',
          'phone',
          'email',
          'hostName',
          'expectedCheckoutTime',
          'status',
          'type',
        ])
        && newData.keys().hasOnly([
          'name',
          'company',
          'phone',
          'email',
          'idType',
          'idNumber',
          'hostName',
          'hostEmail',
          'purpose',
          'duration',
          'durationMinutes',
          'agreed',
          'type',
          'photoUrl',
          'badgeNumber',
          'checkInTime',
          'checkInBy',
          'expectedArrivalTime',
          'expectedCheckoutTime',
          'status',
          'profileId',
          'frequentVisitorId',
          'registeredBy',
          'hostId',
          'registrationTime',
          'registrationEmailSent',
          'createdAt',
        ])
        // Kiosk cannot spoof ownership (null when logged out, own uid when
        // signed in) or verification state.
        && (newData.status != 'Pre-Registered' || !('photoUrl' in newData) || newData.photoUrl == null)
        && (!('registeredBy' in newData) || newData.registeredBy == null
          || (request.auth != null && newData.registeredBy == request.auth.uid))
        && (!('checkInBy' in newData) || newData.checkInBy == null
          || (request.auth != null && newData.checkInBy == request.auth.uid))
        && (!('hostId' in newData) || newData.hostId == null)
        && (!('facialVerificationStatus' in newData) || newData.facialVerificationStatus == null)
        && (!('verificationStatus' in newData) || newData.verificationStatus == null)
        && isPhotoAllowed(newData);
    }

    // Badge check-in from the logged-out kiosk:
    // Pre-Registered -> Checked In + facial capture only.
    function isKioskVisitCheckInAllowed(before, after) {
      return before.status == 'Pre-Registered'
        && after.status == 'Checked In'
        && after.diff(before).affectedKeys().hasOnly([
          'status',
          'photoUrl',
          'checkInTime',
          'checkInBy',
          'expectedCheckoutTime',
          'duration',
          'durationMinutes',
          'frequentVisitorId',
        ])
        && (!('checkInBy' in after) || after.checkInBy == null
          || (request.auth != null && after.checkInBy == request.auth.uid))
        && isPhotoAllowed(after);
    }

    // After the kiosk sends confirmation emails it flips only this flag.
    function isKioskRegistrationFlagAllowed(before, after) {
      return before.status == 'Pre-Registered'
        && after.status == 'Pre-Registered'
        && after.diff(before).affectedKeys().hasOnly(['registrationEmailSent']);
    }

    // "Save as Frequent Visitor" button on the logged-out badge screen.
    function isKioskProfileCreateAllowed(newData) {
      return newData.name is string
        && newData.name.size() > 0
        && newData.phone is string
        && newData.phone.size() > 0
        && newData.keys().hasAll(['name', 'phone'])
        && newData.keys().hasOnly([
          'name',
          'nameLower',
          'company',
          'phone',
          'email',
          'idType',
          'idNumber',
          'photoUrl',
          'defaultHostName',
          'defaultHostEmail',
          'defaultPurpose',
          'defaultDuration',
          'visitCount',
          'lastVisit',
          'createdAt',
          'createdBy',
        ])
        && (!('createdBy' in newData) || newData.createdBy in ['host', 'kiosk'])
        && (!('visitCount' in newData) || newData.visitCount is int)
        && isPhotoAllowed(newData);
    }

    // ----- Visitor visits (least-privilege + kiosk self-service) -----
    // Badge-first flow:
    //   1. Host/Admin creates the badge -> Pre-Registered visit with a
    //      host-issued badgeNumber; visitor + host are notified by email.
    //   2. Visitor arrives and presents the badge number; reception looks the
    //      visit up by badge and captures the facial photo on the staff device,
    //      OR the logged-out kiosk captures it via the narrow kiosk branch.
    //   3. Staff flips the visit Pre-Registered -> Checked In with the
    //      facial capture attached (photoUrl / facialVerification* fields).
    // Reads stay authenticated-only: knowing a badge number grants nothing.
    // Writes allow: staff (anything valid), host (own pre-registrations),
    // kiosk/anon (strictly-validated self check-in only, no read/delete).
    // The visit lifecycle is Pre-Registered -> Checked In -> Checked Out.
    match /visitors/{id} {
      // Staff record walk-ins; hosts pre-register under their own account;
      // logged-out kiosk self check-in (Confirm & Send) via strict shape.
      allow create: if isStaff()
        || (isHost() && isHostRegistrationCreateAllowed(request.resource.data))
        || isKioskVisitorCreateAllowed(request.resource.data);
      // Staff see every visit (badge lookup at reception); a Host sees only
      // the visits they registered (matched by registeredBy or hostId).
      allow read: if isStaff()
        || (isHost() && (resource.data.registeredBy == request.auth.uid
          || resource.data.hostId == request.auth.uid));
      // Staff may progress a visit (reception face-capture check-in, extend,
      // reminders, check-out, verification) but only within the allowed
      // lifecycle and field set. A Host may only mark their pre-registration
      // email as sent, or extend the end time of their own checked-in visit.
      // The logged-out kiosk may complete badge check-in + email-sent flag.
      allow update: if (isStaff() && isVisitUpdateAllowed(resource.data, request.resource.data))
        || (isHost() && isHostRegistrationUpdateAllowed(resource.data, request.resource.data))
        || (isHost() && isHostExtendAllowed(resource.data, request.resource.data))
        || isKioskVisitCheckInAllowed(resource.data, request.resource.data)
        || isKioskRegistrationFlagAllowed(resource.data, request.resource.data);
      // Audit integrity: visit records are never deleted by day-to-day staff.
      allow delete: if isSuperAdmin();
    }

    // ----- Frequent-visitor profiles -----
    // Staff manage the directory. Hosts may read/reuse profiles, create
    // host-owned ones (photo allowed, capped), and bump visit counters.
    // The logged-out badge screen may create a profile via the strict kiosk
    // shape. Reads stay authenticated-only; updates never widen access.
    match /frequentVisitors/{id} {
      allow read: if isStaff() || isHost();
      allow create: if isStaff()
        || (isHost() && isHostProfileCreateAllowed(request.resource.data))
        || isKioskProfileCreateAllowed(request.resource.data);
      allow update: if isStaff()
        || (isHost() && isFrequentCounterUpdateAllowed(resource.data, request.resource.data));
      allow delete: if isStaff();
    }

    // ----- Staff-only directories -----
    match /deliveries/{id} {
      allow read, create, update, delete: if isStaff();
    }

    match /hosts/{id} {
      // Staff manage the directory. A Host can read only their own linked
      // directory record (matched by userId == their auth uid).
      allow read: if isStaff() || (isHost() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isStaff();
    }

    match /contractors/{id} {
      allow read, write: if isStaff();
    }

    match /preRegistrations/{id} {
      allow read, write: if isStaff();
    }

    // ----- App settings (Super Admin writes; readable by all) -----
    // Publicly readable so the check-in UI can show the organization name and
    // default visit duration. Contains only non-sensitive configuration.
    match /appSettings/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ----- Users / roles -----
    // A user may read their own record (checked first so bootstrap never
    // depends on reading a role doc that does not exist yet); Super Admins
    // manage everyone. The first Super Admin must be created in the Firebase
    // Console (Authentication -> Add user, then Firestore -> users/<uid> with
    // role "super-admin"). In-app signups create Receptionist/Host only,
    // so no account can ever elevate itself to super-admin.
    match /users/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn()
        && uid == request.auth.uid
        && request.resource.data.role in ['receptionist', 'host'];
      allow update, delete: if isSuperAdmin();
    }
  }
}