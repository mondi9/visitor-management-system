# Firebase project credentials for the Visitor Management System.
# Copy this file to .env and fill in the values from your own Firebase project
# (Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup).
# Format: KEY=value (no quotes, no trailing commas).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS credentials (https://dashboard.emailjs.com -> Account -> API Keys / Email Services).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=